<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="OpenClaw.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Colors - OpenClaw Theme (amber/copper accent) -->
            <Color x:Key="AppAccentColor">#b47840</Color>
            <Color x:Key="AppAccentHoverColor">#c8885a</Color>
            <Color x:Key="AppBackgroundColor">#0e1015</Color>
            <Color x:Key="AppBackgroundElevatedColor">#13151b</Color>
            <Color x:Key="AppPanelColor">#161920</Color>
            <Color x:Key="AppInsetColor">#191c24</Color>
            <Color x:Key="AppHoverColor">#1f2330</Color>
            <Color x:Key="AppStrokeColor">#2a2f3a</Color>
            <Color x:Key="AppTextColor">#f0f0f2</Color>
            <Color x:Key="AppTextSecondaryColor">#888c9c</Color>
            <Color x:Key="AppMutedColor">#5c6370</Color>
            
            <!-- Brushes - OpenClaw Theme -->
            <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="AppAccentHoverBrush" Color="{StaticResource AppAccentHoverColor}" />
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="AppBackgroundElevatedBrush" Color="{StaticResource AppBackgroundElevatedColor}" />
            <SolidColorBrush x:Key="AppPanelBrush" Color="{StaticResource AppPanelColor}" />
            <SolidColorBrush x:Key="AppInsetBrush" Color="{StaticResource AppInsetColor}" />
            <SolidColorBrush x:Key="AppHoverBrush" Color="{StaticResource AppHoverColor}" />
            <SolidColorBrush x:Key="AppStrokeBrush" Color="{StaticResource AppStrokeColor}" />
            <SolidColorBrush x:Key="AppTextBrush" Color="{StaticResource AppTextColor}" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="{StaticResource AppTextSecondaryColor}" />
            <SolidColorBrush x:Key="AppTextMutedBrush" Color="{StaticResource AppMutedColor}" />
            <SolidColorBrush x:Key="AppAccentTextBrush" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="AppUserBubbleBrush" Color="#1f2330" />
            <SolidColorBrush x:Key="AppSubtleStrokeBrush" Color="#374151" />
            <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="AppPaneBackgroundBrush" Color="{StaticResource AppPanelColor}" />
            
            <!-- Styles -->
            <Style x:Key="SurfaceCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource AppPanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>
            
            <Style x:Key="BodySecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource AppTextSecondaryBrush}" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            
            <Style x:Key="LabelTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
