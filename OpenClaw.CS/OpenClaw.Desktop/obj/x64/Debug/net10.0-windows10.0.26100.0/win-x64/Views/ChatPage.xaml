<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClaw.Desktop.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    
    <Grid Padding="20" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>
        
        <!-- Main Chat Area -->
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="OpenClaw - AI Coding Agent" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:ConnectionId='12' x:Name="StatusText" Text="Ready" Foreground="{StaticResource AppTextSecondaryBrush}" />
            </StackPanel>
            
            <!-- Messages -->
            <Border Grid.Row="1" Style="{StaticResource SurfaceCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <ListView x:ConnectionId='8' x:Name="MessagesList"
                        Grid.Row="0"
                        Padding="16"
                        Background="Transparent"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Border MaxWidth="700"
                                        Background="{StaticResource AppPanelBrush}"
                                        BorderBrush="{StaticResource AppStrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14,10">
                                        <StackPanel Spacing="6">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Author}" />
                                            <TextBlock Text="{Binding Content}" TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    
                    <!-- Input -->
                    <Grid Grid.Row="1" Padding="16" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <TextBox x:ConnectionId='9' x:Name="PromptTextBox"
                            Grid.Column="0"
                            MinHeight="80"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            Background="{StaticResource AppInsetBrush}"
                            BorderBrush="{StaticResource AppStrokeBrush}"
                            Foreground="{StaticResource AppTextBrush}" />
                        
                        <Button x:ConnectionId='10' x:Name="SendButton"
                            Grid.Column="1"
                            Content="Send"
                                              
                            Background="{StaticResource AppAccentBrush}"
                            Foreground="#16110D"
                            VerticalAlignment="Bottom"
                            Padding="24,10" />
                    </Grid>
                </Grid>
            </Border>
            
            <!-- Permission Mode -->
            <ComboBox x:ConnectionId='7' Grid.Row="2" x:Name="PermissionModeBox"
                HorizontalAlignment="Stretch"
                SelectedIndex="0"
                                                         >
                <ComboBoxItem Content="Default (Ask Everything)" />
                <ComboBoxItem Content="Plan Mode (Read-Only)" />
                <ComboBoxItem Content="Accept Edits" />
                <ComboBoxItem Content="Auto Mode" />
                <ComboBoxItem Content="Bypass (Dangerous)" />
            </ComboBox>
        </Grid>
        
        <!-- Right Panel -->
        <StackPanel Grid.Column="1" Spacing="12">
            <!-- Session Info -->
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Session" FontWeight="SemiBold" Foreground="{StaticResource AppAccentTextBrush}" />
                    <TextBlock x:ConnectionId='5' x:Name="SessionIdText" Text="New Session" FontSize="11" />
                    <TextBlock x:ConnectionId='6' x:Name="TokenCountText" Text="0 tokens" FontSize="11" />
                </StackPanel>
            </Border>
            
            <!-- Active Tools -->
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Active Tools" FontWeight="SemiBold" Foreground="{StaticResource AppAccentTextBrush}" />
                    <TextBlock x:ConnectionId='4' x:Name="ToolsText" Text="Loading..." FontSize="11" />
                </StackPanel>
            </Border>
            
            <!-- MCP Servers -->
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="MCP Servers" FontWeight="SemiBold" Foreground="{StaticResource AppAccentTextBrush}" />
                    <TextBlock x:ConnectionId='3' x:Name="McpText" Text="None connected" FontSize="11" />
                </StackPanel>
            </Border>
            
            <!-- Memory -->
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Memory" FontWeight="SemiBold" Foreground="{StaticResource AppAccentTextBrush}" />
                    <TextBlock x:ConnectionId='2' x:Name="MemoryText" Text="No active memories" FontSize="11" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>

